# Run from the repository root: doxygen Doxyfile
PROJECT_NAME           = "Navmesh Generator"
PROJECT_BRIEF          = "Offline Skyrim navmesh analysis and affected-cell batch override generation"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/api.md

# Document only code owned by this project; lib and tools contain vendored code.
INPUT                 = src docs README.md fixtures/README.md tests/integration/README.md
FILE_PATTERNS         = *.h *.hpp *.cpp *.md
RECURSIVE             = YES
EXCLUDE               = docs/tasks
EXCLUDE_PATTERNS      = */schemas/*
EXTRACT_ALL           = YES
EXTRACT_PRIVATE       = NO
EXTRACT_STATIC        = NO
HIDE_UNDOC_MEMBERS    = NO
SOURCE_BROWSER        = YES
INLINE_SOURCES        = NO

GENERATE_HTML         = YES
HTML_OUTPUT           = html
GENERATE_TREEVIEW     = YES
SEARCHENGINE          = YES
GENERATE_LATEX        = NO
QUIET                 = YES
WARNINGS              = YES
WARN_IF_UNDOCUMENTED  = NO
WARN_IF_DOC_ERROR     = YES
WARN_AS_ERROR         = NO
